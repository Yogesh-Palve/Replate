{
  "expo": {
    "name": "RePlate",
    "slug": "replate",
    "scheme": "replate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/branding/replate-app-icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/replate-splash.png",
          "imageWidth": 292,
          "backgroundColor": "#F8F9F5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.replate.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/replate-adaptive-foreground.png",
        "backgroundColor": "#F8F9F5"
      }
    }
  }
}
